{
  "manifest_version": 3,
  "name": "TabBridge",
  "short_name": "TabBridge",
  "version": "0.1.0",
  "description": "Move your browsing workspace between devices—privately.",
  "minimum_chrome_version": "90",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabBridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  }
}
